
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #253550;
  background: #f5f8fd;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --blue: #477fe8;
  --blue-dark: #3067d0;
  --blue-soft: #edf3ff;
  --ink: #253550;
  --muted: #8491a7;
  --line: #e8edf5;
  --line-soft: #eff3f8;
  --panel: #ffffff;
  --surface-soft: #f7f9fd;
  --purple: #8b78d9;
  --green: #4da98b;
  --shadow: 0 8px 28px rgba(37, 61, 102, 0.045);
  --shadow-card-hover: 0 12px 30px rgba(37, 61, 102, 0.09);
  --danger: #cf6258;
  --danger-soft: #fff0ee;
  --warning: #c99443;
  --warning-soft: #fff6e7;
  --success: #399a78;
  --success-soft: #e9f8f1;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; }
button, input, select { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .55; }
button:focus-visible, input:focus-visible, select:focus-visible {
  outline: 3px solid #a9c5ff;
  outline-offset: 2px;
}
button, input, select { -webkit-tap-highlight-color: transparent; }

.app-shell { min-height: 100vh; }
.sidebar {
  position: fixed; inset: 0 auto 0 0; z-index: 20;
  width: 252px; padding: 27px 16px 16px;
  display: flex; flex-direction: column;
  background: #fff; border-right: 1px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 10px; padding: 0 10px; }
.brand-mark {
  width: 38px; height: 38px; border-radius: 13px;
  display: grid; place-items: center;
  background: linear-gradient(145deg, #6797f3, #396ed7);
  color: #fff; font: 800 20px Manrope, sans-serif;
  box-shadow: 0 5px 12px #477fe832;
}
.brand strong { display: block; font: 800 22px Manrope, sans-serif; letter-spacing: -1px; }
.brand small { display: block; margin-top: 1px; color: #9aa6ba; font-size: 8px; font-weight: 700; letter-spacing: 1.3px; }
.sidebar-profile {
  display: flex; align-items: center; gap: 10px; margin: 32px 0 29px;
  padding: 13px 11px; border: 1px solid #edf1f8; border-radius: 14px;
  background: #fbfcff;
}
.avatar {
  width: 35px; height: 35px; flex: 0 0 auto; display: grid; place-items: center;
  border-radius: 12px; color: #3f71d4; background: #e8efff; font-weight: 800;
}
.sidebar-profile strong, .sidebar-profile span { display: block; }
.sidebar-profile strong { font-size: 12px; }
.sidebar-profile div > span { margin-top: 4px; color: var(--muted); font-size: 10px; }
.profile-dot { width: 7px; height: 7px; margin-left: auto; border-radius: 50%; background: #6dc7a7; }
.nav-label, .eyebrow {
  display: block; color: #98a5b9; font-size: 9px; font-weight: 700;
  letter-spacing: 1.45px;
}
.nav-label { padding: 0 12px 12px; }
.side-nav { display: grid; gap: 5px; overflow-y: auto; }
.nav-item {
  min-height: 43px; width: 100%; display: flex; align-items: center; gap: 12px;
  padding: 0 12px; border: 0; border-radius: 11px;
  background: transparent; color: #718098; text-align: left; font-size: 12px; font-weight: 600;
  transition: background .18s, color .18s;
}
.nav-item:hover { background: #f5f8ff; color: var(--blue-dark); }
.nav-active { color: var(--blue-dark); background: #edf3ff; }
.nav-icon { width: 20px; text-align: center; font-size: 19px; }
.nav-coming { margin-left: auto; color: #8e9bb0; font-size: 9px; }
.nav-count { margin-left: auto; min-width: 19px; padding: 3px 5px; border-radius: 8px; background: #f2edff; color: #8269ce; text-align: center; font-size: 10px; }
.sidebar-bottom { margin-top: auto; }
.sidebar-goal { display: flex; gap: 10px; padding: 14px 10px; border-radius: 13px; background: #f6f8ff; }
.sidebar-goal > span { color: var(--blue); font-size: 19px; }
.sidebar-goal strong { display: block; font-size: 10px; }
.sidebar-goal small { display: block; margin-top: 6px; color: var(--muted); font-size: 10px; }
.mini-track, .progress-track, .goal-track {
  overflow: hidden; border-radius: 100px; background: #edf1f8;
}
.mini-track { width: 145px; max-width: 100%; height: 5px; margin-top: 8px; }
.mini-track span, .progress-track span, .goal-track span {
  display: block; height: 100%; border-radius: inherit;
  background: linear-gradient(90deg, #76a2fa, #477fe8); transition: width .25s;
}
.sidebar-footer { display: flex; justify-content: space-between; padding: 17px 7px 0; color: #a1acbd; font-size: 9px; }
.sidebar-footer span { color: #7da1ee; }

.main-content { min-height: 100vh; margin-left: 252px; padding: 35px 42px 20px; }
.content-inner { max-width: 1160px; margin: 0 auto; }
.mobile-topbar, .mobile-nav { display: none; }
.page-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
.page-header h1 { margin: 8px 0 7px; font: 800 clamp(24px, 2.5vw, 31px)/1.2 Manrope, sans-serif; letter-spacing: -1.2px; }
.page-header p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
.date-pill { flex: 0 0 auto; padding: 9px 13px; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: #687791; font-size: 11px; }
.profile-controls {
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  padding: 11px 14px; margin: 0 0 20px; border: 1px solid var(--line);
  border-radius: 14px; background: #fff;
}
.profile-label { display: flex; align-items: center; gap: 9px; margin-right: auto; }
.profile-label strong, .profile-label span:not(.avatar) { display: block; }
.profile-label strong { font-size: 11px; }
.profile-label div span { margin-top: 3px; color: var(--muted); font-size: 10px; }
.profile-controls > label { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 10px; }
.profile-controls select { max-width: 125px; }

.exam-hero {
  position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: center;
  min-height: 210px; margin-bottom: 19px; padding: 28px 31px;
  border-radius: 20px; color: #fff;
  background: linear-gradient(112deg, #396dd0 0%, #4b82e5 57%, #7a9ff0 100%);
}
.hero-content { position: relative; z-index: 2; max-width: 70%; }
.hero-label { font-size: 9px; font-weight: 700; letter-spacing: 1.8px; color: #dce8ff; }
.exam-hero h2 { margin: 11px 0 8px; font: 800 29px Manrope, sans-serif; letter-spacing: -.8px; }
.exam-hero p { margin: 0 0 18px; color: #e4ecff; font-size: 11px; }
.hero-selects { display: flex; gap: 10px; flex-wrap: wrap; }
.hero-selects label { display: grid; gap: 5px; color: #dce8ff; font-size: 9px; }
.hero-selects select, .hero-selects input {
  width: 150px; min-height: 33px; padding: 0 8px; border: 1px solid #ffffff45;
  border-radius: 8px; color: #fff; background: #ffffff19; font-size: 10px;
}
.hero-selects option { color: #253550; }
.hero-selects input { width: 185px; color-scheme: dark; }
.countdown {
  position: relative; z-index: 2; flex: 0 0 auto; width: 140px; min-height: 133px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 1px solid #ffffff42; border-radius: 18px; background: #ffffff15; backdrop-filter: blur(6px);
}
.countdown span { color: #e0eaff; font-size: 8px; font-weight: 700; letter-spacing: 1.3px; }
.countdown strong { margin: 3px 0; font: 800 54px Manrope, sans-serif; letter-spacing: -3px; }
.countdown small { color: #e0eaff; font-size: 9px; }
.countdown-units { display: flex; align-items: flex-start; justify-content: center; gap: 8px; width: 100%; margin: 5px 0 8px; }
.countdown-units > div { display: grid; justify-items: center; min-width: 0; }
.countdown-units strong { margin: 0; font-size: 21px; letter-spacing: -.8px; line-height: 1.1; }
.countdown-units small { font-size: 8px; }
.hero-orb { position: absolute; border-radius: 50%; border: 1px solid #ffffff1c; pointer-events: none; }
.orb-one { width: 270px; height: 270px; right: 85px; top: -180px; }
.orb-two { width: 220px; height: 220px; right: 210px; bottom: -190px; }

.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; margin-bottom: 19px; }
.stat-card { display: flex; align-items: flex-start; gap: 11px; min-width: 0; padding: 17px 14px; border: 1px solid var(--line); border-radius: 15px; background: #fff; box-shadow: var(--shadow); }
.stat-icon { display: grid; place-items: center; width: 35px; height: 35px; flex: 0 0 auto; border-radius: 11px; font-size: 18px; }
.stat-icon.blue { background: #eaf1ff; color: #477fe8; }
.stat-icon.lilac { background: #f0ecff; color: #8b78d9; }
.stat-icon.mint { background: #e6f8f1; color: #39a27c; }
.stat-icon.peach { background: #fff0e7; color: #e29a66; }
.stat-card > div { min-width: 0; }
.stat-card span:not(.stat-icon) { display: block; color: var(--muted); font-size: 10px; }
.stat-card strong { display: block; margin: 6px 0 4px; font: 800 22px Manrope, sans-serif; letter-spacing: -.7px; }
.stat-card small { color: #9aa6b8; font-size: 9px; }

.dashboard-page { display: grid; gap: 17px; align-content: start; min-width: 0; }
.dashboard-page > .page-header { margin-bottom: 0; }
.dashboard-page > .profile-controls { margin-bottom: 0; }
.dashboard-page > .exam-hero { margin-bottom: 0; }
.dashboard-columns { display: grid; grid-template-columns: minmax(0, 1fr); gap: 17px; min-width: 0; }
.dashboard-summary { display: grid; gap: 14px; min-width: 0; }
.dashboard-summary .stats-grid, .dashboard-summary .panel { margin-bottom: 0; }
.dashboard-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: stretch; }
.dashboard-stat-button { width: 100%; color: inherit; text-align: left; transition: border-color .18s, box-shadow .18s; cursor: pointer; }
.dashboard-stat-button:hover { border-color: #d5e2fb; box-shadow: 0 10px 24px rgba(37, 61, 102, .09); }
.dashboard-stat-button:focus-visible { outline: 3px solid #a9c5ff; outline-offset: 2px; }
.dashboard-work-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 17px; align-items: stretch; min-width: 0; }
.dashboard-page .timer-panel, .dashboard-page .dashboard-task-panel, .dashboard-page .dashboard-activity-panel { margin-bottom: 0; }
.dashboard-work-row > .panel { min-width: 0; }
.dashboard-task-panel { display: flex; flex-direction: column; }
.dashboard-task-panel .task-list { flex: 1; }
.dashboard-task-expand { display: block; margin: 12px auto 0; }
.dashboard-summary .task-status-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.timer-panel { display: flex; flex-direction: column; }
.timer-panel .timer-face { width: min(100%, 170px); height: 170px; margin-top: 0; }
.timer-panel .timer-readout strong { font-size: 37px; }
.timer-time-added { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin: 7px 0 0; color: #8491a7; font-size: 10px; }
.timer-time-added strong { color: var(--ink); font-variant-numeric: tabular-nums; }
.timer-time-added span { color: #9aa6b8; font-size: 9px; text-align: right; }
.timer-panel .timer-actions { margin-top: 12px; }
.timer-panel .timer-actions .button-ghost { flex: 0 0 auto; }
.timer-panel .timer-actions .button:disabled { transform: none; }
.timer-settings-toggle { align-self: center; margin-top: 10px; }
.timer-settings { display: grid; gap: 11px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #eff2f7; }
.timer-settings[hidden] { display: none; }
.timer-settings .mode-switch { margin: 0 auto; }
.timer-settings .duration-row { margin: 0; }
.timer-settings .timer-custom-duration { margin: 0; }
.timer-settings .chapter-field { margin-top: 0; }
.task-status-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
.task-status-summary { min-width: 0; padding: 12px; border: 1px solid #eff2f8; border-radius: 11px; background: #fbfcff; }
.task-status-summary > div:first-child { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; margin-bottom: 10px; }
.task-status-summary > div:first-child span { min-width: 0; color: #74839a; font-size: 10px; line-height: 1.4; }
.task-status-summary > div:first-child strong { color: var(--ink); font: 800 14px Manrope, sans-serif; }
.task-progress-panel .progress-track { height: 7px; border: 1px solid #e8eef9; background: #f0f4fb; }
.task-progress-panel .status-bar { min-width: 0; background: linear-gradient(90deg, #8db0fa, #477fe8); }
.task-progress-panel .status-bar-in-progress { background: linear-gradient(90deg, #8db0fa, #477fe8); }
.task-progress-panel .status-bar-ongoing { background: linear-gradient(90deg, #c0b3ff, #8b78d9); }
.task-progress-panel .status-bar-completed { background: linear-gradient(90deg, #81d2b2, #4da98b); }
.task-progress-panel .status-bar-cancelled { background: linear-gradient(90deg, #c8d0dc, #8d99aa); }

.panel { min-width: 0; margin-bottom: 18px; padding: 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); box-shadow: var(--shadow); }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 17px; }
.panel-heading h3 { margin: 6px 0 0; font: 800 16px Manrope, sans-serif; letter-spacing: -.4px; }
.panel-heading > strong { font: 800 19px Manrope, sans-serif; }
.live-dot { display: flex; align-items: center; gap: 6px; color: #8a97aa; font-size: 10px; }
.live-dot::before { width: 6px; height: 6px; border-radius: 50%; background: #69c6a3; content: ''; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 38px; padding: 0 15px; border: 1px solid transparent; border-radius: 10px; font-size: 11px; font-weight: 700; transition: transform .15s, background .15s; }
.button:hover { transform: translateY(-1px); }
.button-primary { background: var(--blue); color: #fff; box-shadow: 0 4px 10px #477fe823; }
.button-primary:hover { background: var(--blue-dark); }
.button-ghost { border-color: var(--line); background: #fff; color: #65748d; }
.button-ghost:hover { background: #f7f9fd; }
.text-button { padding: 7px 0; border: 0; background: transparent; color: var(--blue-dark); font-size: 11px; font-weight: 700; }
.mode-switch { display: flex; gap: 4px; width: fit-content; margin: 0 auto; padding: 4px; border-radius: 10px; background: #f3f6fc; }
.mode-switch button { padding: 8px 20px; border: 0; border-radius: 7px; background: transparent; color: #8b98ac; font-size: 10px; font-weight: 700; }
.mode-switch button.active { background: #fff; color: var(--blue-dark); box-shadow: 0 2px 7px #273e6710; }
.timer-face { position: relative; width: 205px; height: 205px; margin: 6px auto 0; display: grid; place-items: center; }
.timer-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
.timer-ring circle { fill: none; stroke-width: 6; }
.ring-bg { stroke: #edf2fb; }
.ring-progress { stroke: #5688ed; stroke-linecap: round; transition: stroke-dasharray .4s linear; }
.timer-readout { position: relative; display: grid; justify-items: center; gap: 5px; }
.timer-readout strong { font: 800 43px Manrope, sans-serif; letter-spacing: -2px; }
.timer-readout span { color: #9aa6ba; font-size: 8px; font-weight: 700; letter-spacing: 1.2px; }
.duration-row { display: flex; justify-content: center; flex-wrap: wrap; gap: 7px; margin: 0 0 18px; }
.duration-row button { padding: 6px 10px; border: 1px solid #e9eef8; border-radius: 8px; background: #fff; color: #8390a5; font-size: 10px; }
.duration-row button.selected { border-color: #cbdcff; background: #edf3ff; color: var(--blue-dark); font-weight: 700; }
.timer-selects { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.field, .timer-selects label { display: grid; gap: 7px; color: #7e8ba0; font-size: 10px; font-weight: 600; }
input, select { width: 100%; min-width: 0; min-height: 38px; padding: 0 11px; border: 1px solid #e4eaf3; border-radius: 9px; background: #fff; color: #34435c; font-size: 11px; }
input::placeholder { color: #b1bac8; }
.timer-selects select { padding: 0 7px; }
.chapter-field { margin-top: 11px; }
.timer-actions { display: flex; gap: 9px; margin-top: 16px; }
.timer-actions .button-primary { flex: 1; }
.micro-note { margin: 13px 0 0; color: #a1acbd; text-align: center; font-size: 9px; line-height: 1.6; }
.quote-panel { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; padding: 29px 27px; background: linear-gradient(145deg, #f3f6ff, #fff 85%); }
.quote-mark { position: absolute; top: 8px; right: 19px; color: #e1e9ff; font: 800 90px Georgia, serif; line-height: 1; }
.quote-panel .eyebrow { position: relative; }
.quote-panel blockquote { position: relative; margin: 24px 0 18px; font: 700 clamp(17px, 1.6vw, 22px)/1.55 Manrope, sans-serif; letter-spacing: -.45px; }
.quote-author { color: #8391aa; font-size: 11px; }
.quote-bottom { display: flex; justify-content: space-between; margin-top: auto; padding-top: 25px; color: #9aa8c0; font-size: 9px; }
.quote-bottom span:last-child { color: #779cf0; }

.task-list { display: grid; }
.task-card-list { gap: 14px; }
.smart-task-card {
  display: grid; gap: 13px; min-width: 0;
  overflow: visible; padding: 18px; border: 1px solid var(--line); border-left: 3px solid #78a2f2; border-radius: 16px;
  background: linear-gradient(145deg, #fff, var(--surface-soft)); box-shadow: var(--shadow);
  transition: border-color .18s, box-shadow .18s, transform .18s;
}
.smart-task-card:hover { transform: translateY(-2px); border-color: #d6e3fa; box-shadow: var(--shadow-card-hover); }
.smart-task-card.task-done { border-left-color: var(--green); background: linear-gradient(145deg, #fff, #f8fcfa); }
.smart-task-heading { display: flex; align-items: flex-start; gap: 11px; min-width: 0; }
.smart-task-heading > .task-check { width: 21px; height: 21px; margin-top: 2px; border-color: #cfd9e8; border-radius: 7px; }
.smart-task-title { display: grid; gap: 4px; flex: 1; min-width: 0; }
.smart-task-title > strong { color: var(--ink); font: 800 16px/1.35 Manrope, sans-serif; letter-spacing: -.25px; overflow-wrap: anywhere; }
.smart-task-title > span:not(.task-status) { color: var(--muted); font-size: 11px; line-height: 1.4; }
.smart-task-title .task-status { width: fit-content; margin-top: 4px; }
.smart-task-title .task-status { padding: 4px 8px; border-radius: 99px; background: var(--surface-soft); color: #718098; font-size: 9px; font-weight: 700; }
.smart-task-title .status-in-progress, .smart-task-title .status-ongoing { background: var(--blue-soft); color: var(--blue-dark); }
.smart-task-title .status-completed { background: var(--success-soft); color: var(--success); }
.smart-task-title .status-cancelled { background: var(--danger-soft); color: var(--danger); }
.task-row .task-status { padding: 4px 8px; border: 1px solid var(--line); border-radius: 99px; background: var(--surface-soft); color: var(--muted); font-size: 10px; font-weight: 700; line-height: 1.2; }
.task-row .status-in-progress, .task-row .status-ongoing { border-color: #dce7fc; background: var(--blue-soft); color: var(--blue-dark); }
.task-row .status-completed { border-color: #d4e8df; background: var(--success-soft); color: var(--success); }
.task-row .status-cancelled { border-color: #f1d9d6; background: var(--danger-soft); color: var(--danger); }
.smart-task-heading > .priority { margin-left: auto; padding: 5px 9px; border-radius: 99px; font-size: 9px; letter-spacing: .2px; }
.smart-task-metadata { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; padding-left: 32px; }
.smart-task-metadata > span:not(.tag) { padding: 5px 9px; border: 1px solid var(--line-soft); border-radius: 99px; background: var(--panel); color: #718098; font-size: 9px; font-weight: 600; }
.smart-task-metadata > span:first-child { border-color: #dce7fc; background: var(--blue-soft); color: var(--blue-dark); }
.smart-task-metrics { display: flex; flex-wrap: wrap; gap: 8px; padding-left: 32px; color: var(--muted); font-size: 9px; }
.smart-task-metrics > span { display: inline-flex; align-items: center; gap: 6px; padding: 7px 9px; border: 1px solid var(--line-soft); border-radius: 9px; background: #fff; }
.smart-task-metrics strong { color: var(--ink); font: 700 10px Manrope, sans-serif; }
.question-actions { display: inline-flex; gap: 4px; margin-left: 3px; }
.question-actions button { display: grid; place-items: center; width: 21px; height: 21px; border: 1px solid #dfe8f7; border-radius: 7px; background: var(--blue-soft); color: var(--blue-dark); font-size: 13px; }
.question-actions button:disabled { cursor: not-allowed; opacity: .45; }
.smart-task-progress { display: grid; gap: 7px; padding-left: 32px; }
.smart-task-progress > div:first-child { display: flex; justify-content: space-between; color: var(--muted); font-size: 9px; }
.smart-task-progress > div:first-child strong { color: var(--blue-dark); font: 800 10px Manrope, sans-serif; }
.smart-task-progress .progress-track { height: 7px; background: #e9eef7; }
.smart-task-progress .progress-track span { border-radius: inherit; background: linear-gradient(90deg, #75a0f1, var(--blue)); transition: width .25s ease; }
.smart-task-checkpoints { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; padding: 12px 0 0 32px; border-top: 1px solid var(--line-soft); }
.smart-task-checkpoints label { display: flex; align-items: center; gap: 8px; min-width: 0; padding: 8px 9px; border: 1px solid var(--line-soft); border-radius: 9px; background: #fff; color: #718098; font-size: 9px; cursor: pointer; transition: border-color .15s, background .15s, color .15s; }
.smart-task-checkpoints label:has(input:checked) { border-color: #d4e8df; background: #f2faf6; color: #45876f; }
